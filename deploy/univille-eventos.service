[Unit]
Description=Agenda de eventos Univille
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=univille-eventos
Group=univille-eventos
WorkingDirectory=/opt/univille-eventos/current
EnvironmentFile=/etc/univille-eventos.env
ExecStart=/opt/univille-node/current/bin/node server/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
StateDirectory=univille-eventos
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/univille-eventos
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
TasksMax=128
MemoryMax=384M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=univille-eventos

[Install]
WantedBy=multi-user.target
