[Unit]
Description=Fila de e-mails da Agenda Univille
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=univille-eventos
Group=univille-eventos
WorkingDirectory=/opt/univille-eventos/current
EnvironmentFile=/etc/univille-eventos.env
ExecStart=/opt/univille-node/current/bin/node scripts/process-notifications.js
TimeoutStartSec=30min
UMask=0077
StateDirectory=univille-eventos
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/univille-eventos
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
TasksMax=64
MemoryMax=192M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=univille-notifications
