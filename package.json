{
  "name": "univille-eventos",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "description": "Sistema de solicitação, aprovação e consulta de eventos acadêmicos",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "admin": "node --env-file-if-exists=.env scripts/admin.js",
    "format": "prettier --write client server scripts tests vite.config.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "csv-parse": "^7.0.3",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
